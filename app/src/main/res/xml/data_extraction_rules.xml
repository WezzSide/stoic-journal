<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup policy (D-38). Journal data is private and never leaves the device through
  cloud backup (consistent with android:allowBackup="false"). Device-to-device transfer (which
  allowBackup="false" does not disable for targetSdk >= 31) keeps the user's journal when moving to a
  new phone. AI credentials live in noBackupFilesDir and are excluded by the platform; their Keystore
  key is device-bound anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sj_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
