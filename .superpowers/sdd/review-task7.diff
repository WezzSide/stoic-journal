+private val LightColors = lightColorScheme(
+    primary = Amber700,
+    onPrimary = Color.White,
+    secondary = Slate700,
+    onSecondary = Color.White,
+    background = Stone50,
+    onBackground = Stone900,
+    surface = Stone100,
